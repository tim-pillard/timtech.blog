---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - post
    - posts
    - tagList
  addAllPagesToCollections: true
layout: layouts/home.njk
eleventyComputed:
  title: “{{ tag | safe }}” Articles
permalink: /tags/{{ tag | lower }}/
---
<h1>“{{ tag }}” Articles</h1>

{% set postslist = collections[tag] %}
{% include "postslist.njk" %}

<p>
  <a href="{{ '/tags/' | url }}">See all tags.</a>
  <br/>
  <a href="{{ '/articles/' | url }}">See all articles.</a>
</p>