<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- set documentTitle = (title + " - " + metadata.title) if (title and not standalone) else (title or metadata.title) %}
    {%- set canonicalUrl = page.url | url | absoluteUrl(metadata.url) %}
    {%- set isArticle = page.url and page.url != "/articles/" and page.url.indexOf("/articles/") == 0 %}
    {%- set metaDescription = (collections[tag] | tagDescription(tag)) if isTagPage else (description or metadata.description) %}
    <title>{{ documentTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    {%- if page.url != "/404.html" %}
    <link rel="canonical" href="{{ canonicalUrl }}">
    {%- endif %}
    <link rel="preload" href="{{ '/fonts/firasans-regular.woff2' | url }}" as="font" crossorigin="anonymous">
    <link rel="preload" href="{{ '/fonts/firasans-semibold.woff2' | url }}" as="font" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ '/css/index.css' | url }}">
    {%- if isArticle %}
    {#- Syntax colours: only articles have code blocks. #}
    <link rel="stylesheet" href="{{ '/css/prism-base16-monokai.dark.css' | url }}">
    {%- endif %}
    <link rel="alternate" href="{{ metadata.feed.path | url }}" type="application/atom+xml" title="{{ metadata.title }}">
    <link rel="alternate" href="{{ metadata.jsonfeed.path | url }}" type="application/json" title="{{ metadata.title }}">
    {%- if isArticle %}
    <link rel="alternate" href="{{ (page.url + "index.md") | url }}" type="text/markdown" title="{{ title }} (Markdown)">
    {%- endif %}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/apple-touch-icon.png' | url }}">
    <link rel="icon" href="{{ '/favicon.ico' | url }}"/>
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/favicon-32x32.png' | url }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ '/favicon-16x16.png' | url }}">
    <link rel="manifest" href="{{ '/site.webmanifest' | url }}">
    <meta name="theme-color" content="#fffaf5">
    <meta property="og:title" content="{{ documentTitle }}"/>
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:type" content="{{ 'article' if isArticle else 'website' }}"/>
    {%- if isArticle %}
    <meta property="article:published_time" content="{{ page.date.toISOString() }}"/>
    {%- endif %}
    <meta property="og:url" content="{{ canonicalUrl }}"/>
    {% set openGraphImage %}
    {{ image.path if image and image.path else '/img/mozilla-dino-poster-square-greyscale.png' }}
    {% endset %}
    <meta property="og:image" content="{{ openGraphImage | url | absoluteUrl(metadata.url) }}"/>
    {%- if image and image.alt %}
    <meta property="og:image:alt" content="{{ image.alt }}"/>
    {%- endif %}
    <meta property="og:site_name" content="{{ metadata.title }}"/>
    <meta name="twitter:card" content="summary"/>
    <meta name="twitter:creator" content="{{ metadata.author.twitter }}"/>
    {%- if isArticle %}
    {#- Structured data for search engines: data, not a script that runs. #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | jsonForScript | safe }},
      "description": {{ metaDescription | jsonForScript | safe }},
      "datePublished": {{ page.date.toISOString() | jsonForScript | safe }},
      {%- if image and image.path %}
      "image": {{ image.path | url | absoluteUrl(metadata.url) | jsonForScript | safe }},
      {%- endif %}
      "mainEntityOfPage": {{ canonicalUrl | jsonForScript | safe }},
      "author": {
        "@type": "Person",
        "name": {{ metadata.author.name | jsonForScript | safe }},
        "url": {{ metadata.author.url | jsonForScript | safe }}
      }
    }
    </script>
    {%- endif %}
  </head>
  <body>
    <header>
      {#- The site title is the h1 on the home page only; elsewhere the page title is. #}
      {%- set siteTitleTag = "h1" if page.url == "/" else "p" %}
      <{{ siteTitleTag }} class="site-title">
        <a href="{{ '/' | url }}"><span class="site-logo-frame"><img class="site-logo" src="{{ '/img/logo-dino-144.png' | url }}" alt="" width="48" height="48"></span>{{ metadata.title }}</a>
      </{{ siteTitleTag }}>
      <nav aria-label="Main">
        {#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
        <ul class="nav">
          {%- for entry in collections.all | eleventyNavigation %}
            <li class="nav-item{% if entry.url == "/about/" %} nav-item-highlight{% endif %}">
              <a href="{{ entry.url | url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a>
            </li>
          {%- endfor %}
        </ul>
      </nav>
    </header>

    <main{% if templateClass %} class="{{ templateClass }}"{% endif %}>
      {{ content | safe }}
    </main>

    <footer>
      {% set firstPost = collections.posts | first %}
      <p>
        Built with <a href="https://www.11ty.dev/">Eleventy</a> and <a href="https://github.com/11ty/eleventy-base-blog">eleventy-base-blog</a>.
        <br>
        <a href="{{ firstPost.url | url }}">Setting up this blog (quickly) with Eleventy.</a>
      </p>
        <hr>
        <ul class="footer-links">
          <li>
            <a href="{{ '/about/' | url }}">Timothée Pillard</a>
          </li>
          <li>
            <a rel="me" href="https://hachyderm.io/@tpillard">Mastodon</a>
          </li>
          <li>
            <a rel="me" href="https://twitter.com/tpillard">Twitter</a>
          </li>
          <li>
            <a rel="me" href="https://github.com/tim-pillard">GitHub</a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/timoth%C3%A9e-pillard/">LinkedIn</a>
          </li>
        </ul>
    </footer>
  </body>
</html>