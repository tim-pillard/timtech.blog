<ol reversed class="postlist" role="list">
  {% for post in postslist | reverse %}
    <li class="postlist-item">
      <article>
        <time class="postlist-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
        {#- Heading level: h3 under a section heading (home), h2 right under the page h1. #}
        <h{{ postslistLevel or 3 }} class="postlist-title">
          <a href="{{ post.url | url }}" class="postlist-link">
            {% if post.data.title %}{{ post.data.title }}
            {% else %}
              <code>{{ post.url }}</code>
            {% endif %}
          </a>
        </h{{ postslistLevel or 3 }}>
        {% if post.data.description %}
          <p>
            {{ post.data.description }}
          </p>
        {% endif %}
        <footer class="postlist-item-metadata">
          {% for tag in post.data.tags %}
            {%- if collections.tagList.indexOf(tag) != -1 -%}
              {% set tagUrl %}/tags/{{ tag | lower }}/{% endset %}
              <a href="{{ tagUrl | url }}" class="post-tag">{{ tag }}</a>
            {%- endif -%}
          {% endfor %}
        </footer>
      </article>
    </li>
  {% endfor %}
</ol>
