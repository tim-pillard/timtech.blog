---
layout: layouts/home.njk
standalone: true
---
<p class="greeting">Hey, I'm <a class="accent-link" href="{{ '/about/' | url }}">Tim</a> 👋</p>

{#- Shared with the start of the About page: edit _includes/intro.html. #}
{% set introLearnMore = true %}
{% include "intro.html" %}

<div class="home-heading">
  <h2>Latest Articles</h2>
  <a href="{{ '/articles/' | url }}">All articles</a>
</div>

{% set postslist = collections.posts | head(-3) %}
{% include "postslist.njk" %}

<hr>
<h2 class="visually-hidden">Tags</h2>

<ul class="post-tags-list" role="list">
  {% for tag in collections.tagList %}
    {% set tagUrl %}/tags/{{ tag | lower }}/{% endset %}
    <li>
      <a href="{{ tagUrl | url }}" class="post-tag">{{ tag }}</a>
    </li>
  {% endfor %}
</ul>