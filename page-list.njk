---
layout: layouts/home.njk
title: All Pages
permalink: /page-list/
---
<h1>All Pages</h1>

<h2>Pages</h2>
<ul>
  <li><a href="{{ '/' | url }}">Home</a></li>
  {%- for entry in collections.all %}
    {%- set isArticle = entry.data.tags and ("posts" in entry.data.tags) %}
    {%- set isTagPage = entry.url.indexOf("/tags/") == 0 and entry.url != "/tags/" %}
    {%- if not isArticle and not isTagPage and entry.url != page.url and entry.url != "/" %}
      <li><a href="{{ entry.url | url }}">{{ entry.data.title }}</a></li>
    {%- endif %}
  {%- endfor %}
</ul>

<h2>Articles</h2>
<ul>
  {%- for post in collections.posts | reverse %}
    <li>
      <a href="{{ post.url | url }}">{{ post.data.title }}</a>
      <time datetime="{{ post.date | htmlDateString }}">({{ post.date | readableDate }})</time>
    </li>
  {%- endfor %}
</ul>

<h2>Tags</h2>
<ul>
  {%- for tag in collections.tagList %}
    {%- set tagUrl %}/tags/{{ tag | lower }}/{% endset %}
    <li><a href="{{ tagUrl | url }}">{{ tag }}</a> ({{ collections[tag] | length }})</li>
  {%- endfor %}
</ul>
