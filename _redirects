# Old URLs, kept permanently (HTTP 301). Format works on Netlify and Cloudflare Pages.
# The first matching rule wins, so specific rules come before the wildcard.

# Renamed article (old slug -> new slug, straight to /articles/ in one hop).
/posts/presentation-dashlane-web-extension-security-cross-origin-resource-sharing-cors-options-preflight-same-origin/ /articles/cors-for-the-web-extension-dashlane-2021/ 301
/posts/presentation-dashlane-web-extension-security-cross-origin-resource-sharing-CORS-OPTIONS-preflight-same-origin/ /articles/cors-for-the-web-extension-dashlane-2021/ 301

# /posts/ became /articles/.
/posts /articles/ 301
/posts/* /articles/:splat 301

# The Archives page and the list of all pages are removed.
/archive /articles/ 301
/archive/ /articles/ 301
/page-list / 301
/page-list/ / 301

# The list of all tags is removed (the tags are on the home page). Exact
# matches only: the tag pages (/tags/react/ ...) stay. Removed tags go
# straight to the home page too, in one hop.
/tags / 301
/tags/ / 301
/tags/external/ / 301

